{
  "name": "suki-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Suki Davao — 100% Pure Rust Market Platform (Landing, Mobile, Backend, Foundation API)",
  "scripts": {
    "dev": "cargo run -p suki-landing",
    "landing": "cargo run -p suki-landing",
    "landing:build": "cargo build -p suki-landing --release",
    "mobile": "./scripts/run-android.sh",
    "mobile:run": "./scripts/run-android.sh",
    "mobile:build": "cd mobile && dx build --platform android",
    "backend": "cargo run --manifest-path backend/Cargo.toml",
    "foundation": "cargo run -p suki-foundation-api",
    "check": "cargo check --workspace && cargo check --manifest-path backend/Cargo.toml",
    "check:mobile": "cd mobile && cargo check --target x86_64-linux-android"
  }
}
