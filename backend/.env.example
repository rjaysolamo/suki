# Copy to backend/.env and supply private local values. Never commit .env.
DATABASE_URL=mysql://suki:CHANGE_ME@127.0.0.1:3306/suki
# Use a separate database whose name ends in _test for integration tests.
TEST_DATABASE_URL=mysql://suki:CHANGE_ME@127.0.0.1:3306/suki_test
BIND_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
# false is accepted only for localhost development. Production must use true.
COOKIE_SECURE=false
RUST_LOG=suki_api=info,tower_http=info
# Optional one-time administrator bootstrap, requires at least 16 password bytes.
# Remove both values after the first successful startup.
# BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# Backend-only key restricted to the Routes API and deployment egress identity.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
